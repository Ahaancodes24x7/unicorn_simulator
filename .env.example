# Database. SQLite works out of the box for local dev / rehearsal.
# For PostgreSQL: change `provider` in prisma/schema.prisma to "postgresql" and set e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/unicorn?schema=public"
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL, e.g. Neon): use the *pooled* URL here and the direct URL below.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/unicorn?sslmode=require&pgbouncer=true&connection_limit=5"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/unicorn?sslmode=require"

# Admin allowlist: 1–2 comma-separated emails. Only these may ever sign in to /admin.
ADMIN_EMAILS="ahaanluther@gmail.com,ahaan8547@gmail.com"

# Initial admin password, used ONLY by `npm run db:seed` to create the admin rows
# (stored as a bcrypt hash). Remove it from the environment after seeding.
ADMIN_INITIAL_PASSWORD=""

# Team leads register with an email on one of these domains; the access code is sent there.
LEAD_EMAIL_DOMAINS="gmail.com,googlemail.com"

# Outgoing email (Gmail; required in production): one email per team, the access code to the team lead.
# Leave SMTP_HOST empty in development to print emails to the server console instead.
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT="465", SMTP_USER=you@gmail.com, SMTP_PASS=<App Password>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Unicorn Simulator <you@gmail.com>"

# Public address of the site, used for links in emails (e.g. https://unicorn.example.com).
APP_URL="http://localhost:3000"
