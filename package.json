{
  "name": "unicorn-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Silicon Valley: Unicorn Simulator \u2014 a turn-based startup strategy competition",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "admin:hash": "tsx scripts/hash-password.ts",
    "sim": "tsx scripts/simulate.ts",
    "mail:test": "tsx scripts/test-mail.ts",
    "vercel-build": "node scripts/prepare-db.mjs && prisma generate && prisma db push --skip-generate && tsx prisma/seed.ts && next build",
    "db:prepare": "node scripts/prepare-db.mjs",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "next": "^15.3.0",
    "nodemailer": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
